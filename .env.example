QQ_APP_ID=your_qq_app_id
QQ_APP_SECRET=your_qq_app_secret

LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
# 当前账号可用的模型是 deepseek-flash 和 deepseek-v4-pro。
# deepseek-chat 是旧别名，会被网关悄悄路由到 flash，不建议继续使用。
MAODOU_MODEL=deepseek-v4-pro
# 日常闲聊关掉思考：回复更快，也更省推理 token。
MAODOU_REASONING_EFFORT=none
# deep 模式的工具循环需要多步判断，保留 low。
MAODOU_DEEP_REASONING_EFFORT=low
# 图片识别第一次用 low，识别失败或正文为空时自动升到 high 重试。
MAODOU_VISION_REASONING_EFFORT=low
# 意图解析（把一句话分类成 chat / 任务 / 记忆等）单独用快模型：只输出一个小 JSON，
# 不参与最终回复的写作，所以默认 flash + 关思考。最终回复仍用上面的 MAODOU_MODEL。
MAODOU_INTENT_MODEL=deepseek-flash
MAODOU_INTENT_REASONING_EFFORT=none
# 图片识别使用的视觉模型；设为 0 张可整体关闭图片识别。
MAODOU_VISION_MODEL=deepseek-flash
MAODOU_VISION_MAX_IMAGES_PER_REQUEST=9
MAODOU_VISION_RECENT_MESSAGES=20
MAODOU_VISION_MAX_IMAGE_BYTES=8388608
# 图片描述缓存：同一张图（按字节 sha256 判断）只识别一次，重复发送不再调用视觉模型。
MAODOU_IMAGE_CACHE=1
MAODOU_IMAGE_CACHE_MAX_ROWS=2000

# 表情：实测 QQ 群消息不认 <faceType=1,faceId="267"> 这类标签（三种写法发出去都是
# 一串尖括号原样显示），所以默认 0：机器人改用 emoji 表达情绪，出站前把 [头秃]
# 这种方括号名字删掉，免得屏幕上多出一对难看的括号。
# 留 1 是给「哪天腾讯支持了标签」准备的开关，群里出现过的表情名照样会被记下来。
MAODOU_FACE_TAGS=0

# 表情包：assets/stickers/ 里那批挑好的图，模型写 [抱抱] 出站时会换成一张真的图。
# 素材清单在 manifest.json（名字 + emoji + 标签），名字必须精确匹配，写错字不会发图。
# 设 0 只关掉发表情，聊天照常；换一套素材改 MAODOU_STICKER_DIR（指向含 manifest.json 的目录）。
MAODOU_STICKERS=1
MAODOU_STICKER_DIR=assets/stickers

# 联网搜索与网页抓取统一使用 DeepSeek，无需额外 key；费用从 LLM_API_KEY 的余额扣除。
MAODOU_SEARCH_MAX_RESULTS=5
MAODOU_SEARCH_TIMEOUT_SECONDS=12
MAODOU_WEB_FETCH_MAX_CHARS=8000

# 主动关心：没被 @ 时，有人说「睡不好/累了/心情不好」这类话，会主动接一句简短关心。
# 两级判定：先关键词预筛（不花钱），命中再让便宜模型决定要不要说、说什么；拿不准就不说。
MAODOU_CARE_ENABLED=1
# 用哪个模型做这层判断；留空则复用 MAODOU_VISION_MODEL（便宜的闪模型）。
MAODOU_CARE_MODEL=
# 同一天里一个人最多被主动关心几次。
MAODOU_CARE_DAILY_MAX=2
# 同一个人两次主动关心之间至少隔多少分钟。
MAODOU_CARE_COOLDOWN_MINUTES=180
# 群里每天主动发消息的总上限，定时任务和主动关心共用这个额度。
MAODOU_ACTIVE_MSG_DAILY_MAX=6
# 以上四项都能在群里直接 @ 小毛豆 改（存进 group_preferences，优先级高于本文件）。

# 本地命令执行。readonly 只允许只读白名单；write 允许任意命令但仍禁止提权和危险模式。
MAODOU_SHELL_ENABLED=1
MAODOU_SHELL_MODE=readonly
MAODOU_SHELL_CWD=toolbox
MAODOU_SHELL_TIMEOUT_SECONDS=10
MAODOU_SHELL_MAX_OUTPUT_CHARS=50000

# 读取文档（PDF/Word/Excel/文本）时交给模型的最大字符数。
MAODOU_DOCUMENT_MAX_CHARS=24000

# Empty means all groups currently joined by the bot are allowed.
MAODOU_ALLOWED_GROUP_OPENIDS=
MAODOU_DB_PATH=data/maodou.sqlite3
# 每轮取多少条最近记录来做话题切分（真正进 prompt 的只有当前话题那段）。
MAODOU_RECENT_MESSAGES=60
MAODOU_MAX_CONTEXT_CHARS=24000
MAODOU_REPLY_MAX_CHARS=900
MAODOU_TIMEZONE=Asia/Shanghai
MAODOU_SCHEDULER_INTERVAL_SECONDS=30
# 后台归档：每 300 秒看一次，某群攒够 80 条聊天就压成一段摘要（只出摘要，供理解上下文用；
# 长期记忆只由群里明确说「记住 xx」写入，这里不再自动产记忆）。
MAODOU_MEMORY_INTERVAL_SECONDS=300
MAODOU_MEMORY_BATCH_MESSAGES=80
MAODOU_MEMORY_SEARCH_MESSAGES=20
MAODOU_TASK_MAX_COUNT=20
# 慢任务（联网搜索、读文档、查历史等）超过这么多秒没结果，先回一句“稍等我查一下”。
# 设 0 关闭。
MAODOU_ACK_AFTER_SECONDS=4

