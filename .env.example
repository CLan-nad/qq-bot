QQ_APP_ID=your_qq_app_id
QQ_APP_SECRET=your_qq_app_secret

LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
XIAOXIA_MODEL=deepseek-chat
# 图片识别使用的视觉模型；设为 0 张可整体关闭图片识别。
XIAOXIA_VISION_MODEL=deepseek-flash
XIAOXIA_VISION_MAX_IMAGES_PER_REQUEST=3
XIAOXIA_VISION_RECENT_MESSAGES=20
XIAOXIA_VISION_MAX_IMAGE_BYTES=8388608
# 图片描述缓存：同一张图（按字节 sha256 判断）只识别一次，重复发送不再调用视觉模型。
XIAOXIA_IMAGE_CACHE=1
XIAOXIA_IMAGE_CACHE_MAX_ROWS=2000

# 表情：实测 QQ 群消息不认 <faceType=1,faceId="267"> 这类标签（三种写法发出去都是
# 一串尖括号原样显示），所以默认 0：机器人改用 emoji 表达情绪，出站前把 [头秃]
# 这种方括号名字删掉，免得屏幕上多出一对难看的括号。
# 留 1 是给「哪天腾讯支持了标签」准备的开关，群里出现过的表情名照样会被记下来。
XIAOXIA_FACE_TAGS=0

# 表情包：assets/stickers/ 里那批挑好的图，模型写 [抱抱] 出站时会换成一张真的图。
# 素材清单在 manifest.json（名字 + emoji + 标签），名字必须精确匹配，写错字不会发图。
# 设 0 只关掉发表情，聊天照常；换一套素材改 XIAOXIA_STICKER_DIR（指向含 manifest.json 的目录）。
XIAOXIA_STICKERS=1
XIAOXIA_STICKER_DIR=assets/stickers

# 联网搜索：auto=按 bocha 优先、tavily 兜底；也可显式写 bocha 或 tavily。
# 两个 key 都没有时机器人会直接说“还没配好联网搜索”，不会伪造搜索结果。
# BOCHA_API_KEY 是联网搜索必填项（https://open.bochaai.com 申请）。
XIAOXIA_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BOCHA_API_KEY=
XIAOXIA_SEARCH_MAX_RESULTS=5
XIAOXIA_SEARCH_TIMEOUT_SECONDS=12
XIAOXIA_WEB_FETCH_MAX_CHARS=8000

# 主动关心：没被 @ 时，有人说「睡不好/累了/心情不好」这类话，会主动接一句简短关心。
# 两级判定：先关键词预筛（不花钱），命中再让便宜模型决定要不要说、说什么；拿不准就不说。
XIAOXIA_CARE_ENABLED=1
# 用哪个模型做这层判断；留空则复用 XIAOXIA_VISION_MODEL（便宜的闪模型）。
XIAOXIA_CARE_MODEL=
# 同一天里一个人最多被主动关心几次。
XIAOXIA_CARE_DAILY_MAX=2
# 同一个人两次主动关心之间至少隔多少分钟。
XIAOXIA_CARE_COOLDOWN_MINUTES=180
# 群里每天主动发消息的总上限，定时任务和主动关心共用这个额度。
XIAOXIA_ACTIVE_MSG_DAILY_MAX=6
# 以上四项都能在群里直接 @ 小毛豆 改（存进 group_preferences，优先级高于本文件）。

# 本地命令执行。readonly 只允许只读白名单；write 允许任意命令但仍禁止提权和危险模式。
XIAOXIA_SHELL_ENABLED=1
XIAOXIA_SHELL_MODE=readonly
XIAOXIA_SHELL_CWD=toolbox
XIAOXIA_SHELL_TIMEOUT_SECONDS=10
XIAOXIA_SHELL_MAX_OUTPUT_CHARS=50000

# 读取文档（PDF/Word/Excel/文本）时交给模型的最大字符数。
XIAOXIA_DOCUMENT_MAX_CHARS=24000

# Empty means all groups currently joined by the bot are allowed.
XIAOXIA_ALLOWED_GROUP_OPENIDS=
XIAOXIA_DB_PATH=data/xiaoxia.sqlite3
# 每轮取多少条最近记录来做话题切分（真正进 prompt 的只有当前话题那段）。
XIAOXIA_RECENT_MESSAGES=60
XIAOXIA_MAX_CONTEXT_CHARS=24000
XIAOXIA_REPLY_MAX_CHARS=900
XIAOXIA_TIMEZONE=Asia/Shanghai
XIAOXIA_SCHEDULER_INTERVAL_SECONDS=30
# 后台归档：每 300 秒看一次，某群攒够 80 条聊天就压成一段摘要（只出摘要，供理解上下文用；
# 长期记忆只由群里明确说「记住 xx」写入，这里不再自动产记忆）。
XIAOXIA_MEMORY_INTERVAL_SECONDS=300
XIAOXIA_MEMORY_BATCH_MESSAGES=80
XIAOXIA_MEMORY_SEARCH_MESSAGES=20
XIAOXIA_TASK_MAX_COUNT=20
# 慢任务（联网搜索、读文档、查历史等）超过这么多秒没结果，先回一句“稍等我查一下”。
# 设 0 关闭。
XIAOXIA_ACK_AFTER_SECONDS=6

